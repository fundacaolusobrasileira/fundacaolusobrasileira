# =============================================================================
#  ATENCAO — NUNCA APONTE ESTE FICHEIRO PARA O PROJETO SUPABASE DE PRODUCAO.
#  USE SEMPRE UM PROJETO DEDICADO A TESTES (staging / branch efemera).
#
#  OS TESTES E2E CRIAM E APAGAM DADOS REAIS COM A CHAVE service_role, QUE
#  IGNORA TODAS AS POLICIES DE RLS. tests/e2e/support/e2eCleanup.ts APAGA
#  REGISTOS EM MASSA. APONTAR ISTO PARA PRODUCAO DESTROI DADOS REAIS.
#
#  Copie para `.env.e2e` (ja ignorado pelo git) e preencha com credenciais
#  do projeto de TESTES:   cp .env.e2e.example .env.e2e
#
#  NUNCA faca commit de `.env.e2e`. A service_role key e um segredo de
#  administracao total da base de dados.
# =============================================================================

# -----------------------------------------------------------------------------
# Projeto Supabase de TESTES (nao producao)
# Consumido por: playwright.config.ts, tests/e2e/support/*.ts e pelo build
# `npm run build:e2e`, que embute estes valores no bundle do browser.
# -----------------------------------------------------------------------------
VITE_SUPABASE_URL=https://SEU-PROJETO-DE-TESTES.supabase.co
VITE_SUPABASE_ANON_KEY=cole-aqui-a-anon-key-do-projeto-de-TESTES

# -----------------------------------------------------------------------------
# SEGREDO CRITICO — bypassa RLS por completo.
# Usado em tests/e2e/support/e2eUsers.ts, e2eCleanup.ts,
# adminCreateUserBypass.ts e admin-bypass-server.ts para criar/apagar
# utilizadores e limpar dados entre execucoes.
# So pode pertencer ao projeto de TESTES. Nunca a producao. Nunca no git.
# -----------------------------------------------------------------------------
E2E_SUPABASE_SERVICE_ROLE_KEY=cole-aqui-a-service-role-key-do-projeto-de-TESTES

# -----------------------------------------------------------------------------
# Contas de teste (criadas no projeto de TESTES, nunca contas reais de pessoas)
# -----------------------------------------------------------------------------
E2E_EDITOR_EMAIL=editor.e2e@example.com
E2E_EDITOR_PASSWORD=troque-esta-password

E2E_ADMIN_EMAIL=admin.e2e@example.com
E2E_ADMIN_PASSWORD=troque-esta-password

# -----------------------------------------------------------------------------
# Porta do servidor local de bypass de auth (tests/e2e/support/admin-bypass-server.ts).
# Opcional — o valor por omissao e 8787.
# -----------------------------------------------------------------------------
E2E_AUTH_BYPASS_PORT=8787
